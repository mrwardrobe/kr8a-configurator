# All public metadata uses this canonical origin, including preview builds.
NEXT_PUBLIC_SITE_URL=https://kr8a.com

# Owner-confirmed public details only. Never place service credentials in NEXT_PUBLIC_*.
NEXT_PUBLIC_CONTACT_EMAIL=
NEXT_PUBLIC_PRIVACY_EMAIL=
NEXT_PUBLIC_LEGAL_OPERATOR=
NEXT_PUBLIC_BUSINESS_ADDRESS=

# Search Console HTML meta token (not a GA4 ID). DNS verification is also supported externally.
GOOGLE_SITE_VERIFICATION=

# Measurement is production-only, on https://kr8a.com, and requires visitor opt-in.
# Enable in Vercel settings first. Custom events also require a supported Vercel plan.
ANALYTICS_ENABLED=false
ANALYTICS_CUSTOM_EVENTS_ENABLED=false

# Keep false until a controlled test and owner privacy/legal review have passed.
WAITLIST_ENABLED=false
WAITLIST_LAUNCH_APPROVED=false
RESEND_API_KEY=
RESEND_FROM_EMAIL=
RESEND_SEGMENT_ID=
# Two different cryptographically random secrets, at least 32 characters each.
WAITLIST_TOKEN_SECRET=
WAITLIST_RATE_SECRET=
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# Protected preview tests only: exact HTTPS .vercel.app origin and owner-controlled emails.
# Use separate Resend segment, Redis database and Turnstile widget for preview tests.
WAITLIST_TEST_ORIGIN=
WAITLIST_TEST_EMAILS=
